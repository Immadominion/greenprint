# ─── Greenprint environment ─────────────────────────────────────────────────
# Copy this file to `.env` (or just run `npm run dev`, which creates it for you).

# Local SQLite database file. Everything works fully offline with this default.
DATABASE_URL=file:greenprint.db

# Auth. In dev these can stay as-is. `npm run dev` auto-generates a random secret.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-long-random-string
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Optional: live AI features ─────────────────────────────────────────────
# Greenprint's analysis engine is 100% offline and needs NO key.
# A key only upgrades the AI "Explain" and "Auto-document" features from the
# built-in demo mode to live Claude responses.
# ANTHROPIC_API_KEY=sk-ant-...
# We default to the small, efficient Haiku model (greener + faster). Upgrade to
# claude-sonnet-5 for richer explanations.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
